{
    "openapi": "3.1.1",
    "info": {
        "title": "Semogly.Wallet.Fraud.Api | v1",
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "/api"
        }
    ],
    "paths": {
        "/fraud/accounts/{accountId}/daily-usage": {
            "get": {
                "tags": [
                    "Fraud"
                ],
                "summary": "Consulta quanto do limite diário de transferências a conta já usou hoje",
                "operationId": "GetDailyUsage",
                "parameters": [
                    {
                        "name": "accountId",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "format": "uuid"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/DailyUsageResponse"
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "DailyUsageResponse": {
                "required": [
                    "accountId",
                    "date",
                    "used",
                    "limit",
                    "remaining"
                ],
                "type": "object",
                "properties": {
                    "accountId": {
                        "type": "string",
                        "format": "uuid"
                    },
                    "date": {
                        "type": "string",
                        "format": "date"
                    },
                    "used": {
                        "type": "number",
                        "format": "double"
                    },
                    "limit": {
                        "type": "number",
                        "format": "double"
                    },
                    "remaining": {
                        "type": "number",
                        "format": "double"
                    }
                }
            }
        },
        "securitySchemes": {
            "Bearer": {
                "type": "http",
                "description": "Token emitido em POST /auth/token no Gateway",
                "scheme": "bearer",
                "bearerFormat": "JWT"
            }
        }
    },
    "security": [
        {
            "Bearer": []
        }
    ],
    "tags": [
        {
            "name": "Fraud"
        }
    ]
}