{
    "openapi": "3.1.1",
    "info": {
        "title": "Semogly.Wallet.Ledger.Api | v1",
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "/api"
        }
    ],
    "paths": {
        "/ledger/book": {
            "get": {
                "tags": [
                    "Ledger"
                ],
                "summary": "Visão do livro-razão: saldos de CashIn, Clearing e clientes (backoffice)",
                "description": "No Gateway, exige o papel operator. Total diferente de zero indica inconsistência contábil.",
                "operationId": "GetBook",
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/LedgerBookResponse"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/ledger/accounts/{accountId}/deposits": {
            "post": {
                "tags": [
                    "Ledger"
                ],
                "summary": "Registra um depósito (entrada de dinheiro externo) na conta",
                "operationId": "Deposit",
                "parameters": [
                    {
                        "name": "accountId",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "format": "uuid"
                        }
                    }
                ],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/DepositRequest"
                            }
                        }
                    },
                    "required": true
                },
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/DepositResponse"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "content": {
                            "application/problem+json": {
                                "schema": {
                                    "$ref": "#/components/schemas/HttpValidationProblemDetails"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "content": {
                            "application/problem+json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ProblemDetails"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Unprocessable Entity",
                        "content": {
                            "application/problem+json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ProblemDetails"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/ledger/accounts/{accountId}/statement": {
            "get": {
                "tags": [
                    "Ledger"
                ],
                "summary": "Consulta o extrato da conta, do lançamento mais recente para o mais antigo",
                "operationId": "GetStatement",
                "parameters": [
                    {
                        "name": "accountId",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "format": "uuid"
                        }
                    },
                    {
                        "name": "page",
                        "in": "query",
                        "schema": {
                            "maximum": 2147483647,
                            "minimum": 1,
                            "type": "integer",
                            "format": "int32",
                            "default": 1
                        }
                    },
                    {
                        "name": "pageSize",
                        "in": "query",
                        "schema": {
                            "maximum": 100,
                            "minimum": 1,
                            "type": "integer",
                            "format": "int32",
                            "default": 20
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/StatementResponse"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "content": {
                            "application/problem+json": {
                                "schema": {
                                    "$ref": "#/components/schemas/HttpValidationProblemDetails"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "content": {
                            "application/problem+json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ProblemDetails"
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "DepositRequest": {
                "required": [
                    "amount"
                ],
                "type": "object",
                "properties": {
                    "amount": {
                        "type": "number",
                        "format": "double"
                    }
                }
            },
            "DepositResponse": {
                "required": [
                    "entryId",
                    "accountId",
                    "amount",
                    "balanceAfter",
                    "occurredAt"
                ],
                "type": "object",
                "properties": {
                    "entryId": {
                        "type": "string",
                        "format": "uuid"
                    },
                    "accountId": {
                        "type": "string",
                        "format": "uuid"
                    },
                    "amount": {
                        "type": "number",
                        "format": "double"
                    },
                    "balanceAfter": {
                        "type": "number",
                        "format": "double"
                    },
                    "occurredAt": {
                        "type": "string",
                        "format": "date-time"
                    }
                }
            },
            "EntryType": {
                "enum": [
                    "Debit",
                    "Credit"
                ]
            },
            "HttpValidationProblemDetails": {
                "type": "object",
                "properties": {
                    "type": {
                        "type": [
                            "null",
                            "string"
                        ]
                    },
                    "title": {
                        "type": [
                            "null",
                            "string"
                        ]
                    },
                    "status": {
                        "type": [
                            "null",
                            "integer"
                        ],
                        "format": "int32"
                    },
                    "detail": {
                        "type": [
                            "null",
                            "string"
                        ]
                    },
                    "instance": {
                        "type": [
                            "null",
                            "string"
                        ]
                    },
                    "errors": {
                        "type": "object",
                        "additionalProperties": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            }
                        }
                    }
                }
            },
            "LedgerBookResponse": {
                "required": [
                    "cashIn",
                    "clearing",
                    "customerBalances",
                    "customerAccounts",
                    "total"
                ],
                "type": "object",
                "properties": {
                    "cashIn": {
                        "type": "number",
                        "format": "double"
                    },
                    "clearing": {
                        "type": "number",
                        "format": "double"
                    },
                    "customerBalances": {
                        "type": "number",
                        "format": "double"
                    },
                    "customerAccounts": {
                        "type": "integer",
                        "format": "int32"
                    },
                    "total": {
                        "type": "number",
                        "format": "double"
                    },
                    "isBalanced": {
                        "type": "boolean"
                    }
                }
            },
            "ProblemDetails": {
                "type": "object",
                "properties": {
                    "type": {
                        "type": [
                            "null",
                            "string"
                        ]
                    },
                    "title": {
                        "type": [
                            "null",
                            "string"
                        ]
                    },
                    "status": {
                        "type": [
                            "null",
                            "integer"
                        ],
                        "format": "int32"
                    },
                    "detail": {
                        "type": [
                            "null",
                            "string"
                        ]
                    },
                    "instance": {
                        "type": [
                            "null",
                            "string"
                        ]
                    }
                }
            },
            "StatementEntryResponse": {
                "required": [
                    "entryId",
                    "type",
                    "amount",
                    "balanceAfter",
                    "transferId",
                    "description",
                    "occurredAt"
                ],
                "type": "object",
                "properties": {
                    "entryId": {
                        "type": "string",
                        "format": "uuid"
                    },
                    "type": {
                        "$ref": "#/components/schemas/EntryType"
                    },
                    "amount": {
                        "type": "number",
                        "format": "double"
                    },
                    "balanceAfter": {
                        "type": "number",
                        "format": "double"
                    },
                    "transferId": {
                        "type": [
                            "null",
                            "string"
                        ],
                        "format": "uuid"
                    },
                    "description": {
                        "type": "string"
                    },
                    "occurredAt": {
                        "type": "string",
                        "format": "date-time"
                    }
                }
            },
            "StatementResponse": {
                "required": [
                    "accountId",
                    "balance",
                    "page",
                    "pageSize",
                    "entries"
                ],
                "type": "object",
                "properties": {
                    "accountId": {
                        "type": "string",
                        "format": "uuid"
                    },
                    "balance": {
                        "type": "number",
                        "format": "double"
                    },
                    "page": {
                        "type": "integer",
                        "format": "int32"
                    },
                    "pageSize": {
                        "type": "integer",
                        "format": "int32"
                    },
                    "entries": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/StatementEntryResponse"
                        }
                    }
                }
            }
        },
        "securitySchemes": {
            "Bearer": {
                "type": "http",
                "description": "Token emitido em POST /auth/token no Gateway",
                "scheme": "bearer",
                "bearerFormat": "JWT"
            }
        }
    },
    "security": [
        {
            "Bearer": []
        }
    ],
    "tags": [
        {
            "name": "Ledger"
        }
    ]
}