{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "accounts-search": {
        "ClusterId": "accounts",
        "Order": -1,
        "AuthorizationPolicy": "operator",
        "RateLimiterPolicy": "per-user",
        "Match": { "Path": "/api/accounts", "Methods": [ "GET" ] },
        "Transforms": [ { "PathRemovePrefix": "/api" } ]
      },
      "accounts": {
        "ClusterId": "accounts",
        "AuthorizationPolicy": "customer",
        "RateLimiterPolicy": "per-user",
        "Match": { "Path": "/api/accounts/{**rest}" },
        "Transforms": [ { "PathRemovePrefix": "/api" } ]
      },
      "transfers-create": {
        "ClusterId": "transfers",
        "Order": -1,
        "AuthorizationPolicy": "customer",
        "RateLimiterPolicy": "transfers",
        "Match": { "Path": "/api/transfers", "Methods": [ "POST" ] },
        "Transforms": [ { "PathRemovePrefix": "/api" } ]
      },
      "transfers-list": {
        "ClusterId": "transfers",
        "Order": -1,
        "AuthorizationPolicy": "operator",
        "RateLimiterPolicy": "per-user",
        "Match": { "Path": "/api/transfers", "Methods": [ "GET" ] },
        "Transforms": [ { "PathRemovePrefix": "/api" } ]
      },
      "transfers": {
        "ClusterId": "transfers",
        "AuthorizationPolicy": "customer",
        "RateLimiterPolicy": "per-user",
        "Match": { "Path": "/api/transfers/{**rest}" },
        "Transforms": [ { "PathRemovePrefix": "/api" } ]
      },
      "ledger-deposits": {
        "ClusterId": "ledger",
        "Order": -1,
        "AuthorizationPolicy": "operator",
        "RateLimiterPolicy": "per-user",
        "Match": { "Path": "/api/ledger/accounts/{accountId}/deposits", "Methods": [ "POST" ] },
        "Transforms": [ { "PathRemovePrefix": "/api" } ]
      },
      "ledger-book": {
        "ClusterId": "ledger",
        "Order": -1,
        "AuthorizationPolicy": "operator",
        "RateLimiterPolicy": "per-user",
        "Match": { "Path": "/api/ledger/book" },
        "Transforms": [ { "PathRemovePrefix": "/api" } ]
      },
      "ledger": {
        "ClusterId": "ledger",
        "AuthorizationPolicy": "customer",
        "RateLimiterPolicy": "per-user",
        "Match": { "Path": "/api/ledger/{**rest}" },
        "Transforms": [ { "PathRemovePrefix": "/api" } ]
      },
      "fraud": {
        "ClusterId": "fraud",
        "AuthorizationPolicy": "customer",
        "RateLimiterPolicy": "per-user",
        "Match": { "Path": "/api/fraud/{**rest}" },
        "Transforms": [ { "PathRemovePrefix": "/api" } ]
      },
      "notifications": {
        "ClusterId": "notifications",
        "AuthorizationPolicy": "customer",
        "RateLimiterPolicy": "per-user",
        "Match": { "Path": "/api/notifications/{**rest}" },
        "Transforms": [ { "PathRemovePrefix": "/api" } ]
      },
      "openapi-accounts": {
        "ClusterId": "accounts",
        "Match": { "Path": "/openapi/accounts.json" },
        "Transforms": [ { "PathSet": "/openapi/v1.json" }, { "RequestHeader": "X-Gateway-Prefix", "Set": "/api" } ]
      },
      "openapi-transfers": {
        "ClusterId": "transfers",
        "Match": { "Path": "/openapi/transfers.json" },
        "Transforms": [ { "PathSet": "/openapi/v1.json" }, { "RequestHeader": "X-Gateway-Prefix", "Set": "/api" } ]
      },
      "openapi-ledger": {
        "ClusterId": "ledger",
        "Match": { "Path": "/openapi/ledger.json" },
        "Transforms": [ { "PathSet": "/openapi/v1.json" }, { "RequestHeader": "X-Gateway-Prefix", "Set": "/api" } ]
      },
      "openapi-fraud": {
        "ClusterId": "fraud",
        "Match": { "Path": "/openapi/fraud.json" },
        "Transforms": [ { "PathSet": "/openapi/v1.json" }, { "RequestHeader": "X-Gateway-Prefix", "Set": "/api" } ]
      },
      "openapi-notifications": {
        "ClusterId": "notifications",
        "Match": { "Path": "/openapi/notifications.json" },
        "Transforms": [ { "PathSet": "/openapi/v1.json" }, { "RequestHeader": "X-Gateway-Prefix", "Set": "/api" } ]
      }
    },
    "Clusters": {
      "accounts": { "Destinations": { "default": { "Address": "https+http://accounts-api" } } },
      "transfers": { "Destinations": { "default": { "Address": "https+http://transfers-api" } } },
      "ledger": { "Destinations": { "default": { "Address": "https+http://ledger-api" } } },
      "fraud": { "Destinations": { "default": { "Address": "https+http://fraud-api" } } },
      "notifications": { "Destinations": { "default": { "Address": "https+http://notifications-api" } } }
    }
  }
}
